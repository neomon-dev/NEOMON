# Frontend
NEXT_PUBLIC_APP_NAME=NEOMON
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Backend (copy to backend/.env for local development)
NEOMON_ENVIRONMENT=development
NEOMON_DEMO_MODE=true
# Leave unset to use the stable backend/neomon.db development database path.
# NEOMON_DATABASE_URL=postgresql+asyncpg://user:password@localhost/neomon
NEOMON_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEOMON_TAVILY_API_KEY=
# Optional: enables polite Unpaywall open-access discovery for DOI records.
NEOMON_UNPAYWALL_EMAIL=
NEOMON_UNPAYWALL_API_KEY=
NEOMON_RESEARCH_MAX_DOCUMENT_BYTES=5000000
# Never place provider keys in NEXT_PUBLIC_* variables.
