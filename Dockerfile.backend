# ==============================================================================
# NEOMON Backend Production Dockerfile
# Multi-stage build with non-root security isolation
# ==============================================================================

# Stage 1: Build & wheels preparation
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt

# Stage 2: Production runtime image
FROM python:3.12-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and group
RUN groupadd -g 10001 neomon && \
    useradd -u 10001 -g neomon -s /bin/bash -m neomon

# Install python dependencies from builder wheels
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# Copy application source code
COPY --chown=neomon:neomon backend/app /app/app
COPY --chown=neomon:neomon backend/migrations /app/migrations
COPY --chown=neomon:neomon backend/alembic.ini /app/alembic.ini

# Create persistent storage directories
RUN mkdir -p /app/storage /app/data && \
    chown -R neomon:neomon /app/storage /app/data

# Environment configuration
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    NEOMON_ENVIRONMENT=production \
    PORT=8000

USER neomon

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
